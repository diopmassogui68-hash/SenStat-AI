# Fichier d'exemple pour les variables d'environnement
# Copiez ce fichier vers .env et remplacez les valeurs

# Module de settings Django
DJANGO_SETTINGS_MODULE=config.settings.dev

# Clé secrète Django (générer une clé unique pour la production)
SECRET_KEY=votre_cle_secrete_ici

# Debug (True en dev, False en prod)
DEBUG=True

# API Gemini (optionnelle — le système fonctionne sans via le NLP déterministe)
GEMINI_API_KEY=votre_cle_api_gemini_ici
